[Unit]
Description=Training Manager — daily notification digest schedule (07:30)

[Timer]
# Daily at 07:30 local time, just after the session-reminder run. Digest users
# get one summary of the prior day's notifications.
OnCalendar=*-*-* 07:30:00
# Catch up if the box was down at the scheduled time.
Persistent=true
Unit=tm-digest.service

[Install]
WantedBy=timers.target
