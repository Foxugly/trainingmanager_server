SECRET_KEY=changeme-generate-with-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# Database. Local dev / CI: leave DB_ENGINE unset and use DATABASE_URL (sqlite).
# Prod (fleet DB_* 6-var convention, OPERATIONS.md §3.13) sets the six DB_* via
# SSM → /run/tm/.env and leaves DATABASE_URL unset:
#   DB_ENGINE=postgresql
#   DB_HOST=127.0.0.1
#   DB_PORT=5432
#   DB_NAME=tm
#   DB_USER=tm
#   DB_PASSWORD=<SecureString in SSM>
DATABASE_URL=sqlite:///db.sqlite3
STATE=INT
WEBSITE=www.example.com

FRONTEND_URL=http://localhost:8000

# CORS origins allowed to call the API (comma-separated, no trailing slash).
# Empty = fail-closed (no cross-origin call accepted). dev.py overrides
# this with the local Angular dev origins so local dev keeps working
# without setting this var.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Microsoft Graph API (envoi d'emails transactionnels)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret
GRAPH_SENDER=your-sender@example.com

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL_DEFAULT=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS_DEFAULT=2048
ANTHROPIC_MAX_TOKENS_PLAN=20000
ANTHROPIC_TIMEOUT_SECONDS=60

# Cloudflare Turnstile (captcha on /auth/register/).
# Both keys are obtained from dash.cloudflare.com -> Turnstile -> Add site.
# TURNSTILE_SITE_KEY is the public widget key; safe to commit and to expose
# in the frontend bundle. TURNSTILE_SECRET_KEY is the server-side
# verification secret; KEEP IT IN .env, never commit.
TURNSTILE_SITE_KEY=0x4AAAAAADI-0tcntdflxEqO
TURNSTILE_SECRET_KEY=your_secret_here

# Dedicated MOBILE Turnstile widget (separate Cloudflare site; hostname allowlist
# pinned to tm-api.foxugly.com). Its host page is served at /turnstile/ and loaded
# by the app's WebView. siteverify accepts a token from EITHER widget (web/mobile).
# SITE_KEY_MOBILE is public (String in SSM); SECRET_KEY_MOBILE is a SecureString.
TURNSTILE_SITE_KEY_MOBILE=your_mobile_site_key_here
TURNSTILE_SECRET_KEY_MOBILE=your_mobile_secret_here

# Firebase Cloud Messaging (push) — dedicated TrainingManager Firebase project,
# NOT PushIT's. FCM_SERVICE_ACCOUNT_PATH is the service-account JSON *filename*,
# resolved relative to the app WorkingDirectory. The JSON file is placed on the
# box out-of-band (640 django:www-data); SSM holds only the filename. Empty ⇒
# the push sender runs in mock mode (no real FCM calls).
FCM_SERVICE_ACCOUNT_PATH=
